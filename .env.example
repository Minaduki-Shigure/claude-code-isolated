# Copy to .env. This file is parsed as literal KEY=VALUE; no shell evaluation.
# No key or password belongs in this file. The credential file stays outside WORKSPACE.
WORKSPACE=/absolute/path/to/project
ANTHROPIC_BASE_URL=https://your-model-provider.example
ANTHROPIC_MODEL=your-model-id
MODEL_AUTH_MODE=bearer
MODEL_API_KEY_FILE=/absolute/private/path/model-api-key
HOST_PROXY_HOST=host.docker.internal
HOST_PROXY_PORT=6152

# Automatic pull of CI-tested latest on each start; --pull never uses cached images.
CLAUDE_IMAGE=ghcr.io/minaduki-shigure/claude-code-isolated:latest
GATEWAY_IMAGE=ghcr.io/minaduki-shigure/claude-code-isolated-gateway:latest
