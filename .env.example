# Copy to .env. This file is parsed as literal KEY=VALUE; no shell evaluation.
# No key or password belongs in this file. The credential file stays outside WORKSPACE.
WORKSPACE=/absolute/path/to/project
ANTHROPIC_BASE_URL=https://your-model-provider.example
ANTHROPIC_MODEL=your-model-id
MODEL_AUTH_MODE=bearer
MODEL_API_KEY_FILE=/absolute/private/path/model-api-key
HOST_PROXY_HOST=host.docker.internal
HOST_PROXY_PORT=6152
# US Pacific time; follows PST/PDT daylight-saving changes automatically.
TZ=America/Los_Angeles

# All memory-backed filesystems share the RAM budget; these are not reservations.
# Positive whole m/g sizes (MiB/GiB); each filesystem cap must be <= RAM limit.
# Keep Docker's VM RAM above the container limit, e.g. 12 GiB for this 8 GiB profile.
# Swap stays disabled: memswap_limit always equals CLAUDE_MEMORY_LIMIT.
CLAUDE_MEMORY_LIMIT=8g
CLAUDE_PIDS_LIMIT=1024
CLAUDE_SHM_SIZE=1g
CLAUDE_HOME_TMPFS_SIZE=4g
CLAUDE_TMP_TMPFS_SIZE=4g

# Automatic pull of CI-tested latest on each start; --pull never uses cached images.
CLAUDE_IMAGE=ghcr.io/minaduki-shigure/claude-code-isolated:latest
GATEWAY_IMAGE=ghcr.io/minaduki-shigure/claude-code-isolated-gateway:latest

# Optional: override the host-only startup preferences file.
# Without this field, config/startup.json is used if present, otherwise the empty example.
# STARTUP_CONFIG_FILE=/absolute/private/path/startup.json
